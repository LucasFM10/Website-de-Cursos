# Supabase - server/runtime
SUPABASE_PROJECT_ID="vskitxnsblhgsfldnfrm"
SUPABASE_URL="https://vskitxnsblhgsfldnfrm.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Supabase - browser/Vite
VITE_SUPABASE_PROJECT_ID="vskitxnsblhgsfldnfrm"
VITE_SUPABASE_URL="https://vskitxnsblhgsfldnfrm.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase Auth Hook - Send SMS
# Self-hosted GoTrue reads GOTRUE_HOOK_SEND_SMS_SECRETS.
# The Edge Function reads SEND_SMS_HOOK_SECRET.
SEND_SMS_HOOK_URI="https://DOMINIO_DO_SUPABASE/functions/v1/send-auth-sms"
SEND_SMS_HOOK_SECRET="v1,whsec_<base64-secret>"
GOTRUE_EXTERNAL_PHONE_ENABLED="true"
GOTRUE_SMS_AUTOCONFIRM="false"
GOTRUE_HOOK_SEND_SMS_ENABLED="true"
GOTRUE_HOOK_SEND_SMS_URI="${SEND_SMS_HOOK_URI}"
GOTRUE_HOOK_SEND_SMS_SECRETS="${SEND_SMS_HOOK_SECRET}"

# Evolution API - server-only, never prefix with VITE_
EVOLUTION_API_URL="https://evolution.example.com"
EVOLUTION_API_KEY="<instance-or-global-api-key>"
EVOLUTION_INSTANCE_NAME="adribacci"
